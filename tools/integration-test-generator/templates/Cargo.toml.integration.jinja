[package]
name = "sqlkit-integration-test-{{ backend_name }}"
version = "0.1.0"
edition = "2024"

[workspace]

[dependencies]
{% if driver == "sqlx" -%}
sqlx = { version = "0.9", features = ["runtime-tokio", "postgres", "chrono", "rust_decimal", "json", "uuid"] }
{%- elif driver == "tokio-postgres" -%}
tokio-postgres = { version = "0.7", features = ["with-chrono-0_4", "with-serde_json-1", "with-uuid-1"] }
{%- endif %}
tokio = { version = "1", features = ["full"] }
chrono = { version = "0.4", features = ["serde"] }
{%- if driver == "tokio-postgres" %}
rust_decimal = { version = "1", features = ["db-tokio-postgres"] }
{%- else %}
rust_decimal = "1"
{%- endif %}
serde = { version = "1", features = ["derive"] }
{%- if driver == "tokio-postgres" %}
# postgres-types is already a transitive dependency of tokio-postgres, but
# without its `derive` feature it does not re-export the `ToSql`/`FromSql`
# derive macros that a generated composite struct needs, and tokio-postgres
# does not forward that feature. Hence the direct declaration.
postgres-types = { version = "0.2", features = ["derive"] }
# postgres-protocol is likewise transitive (postgres-types depends on it
# unconditionally for its own array codec), but it is never re-exported under
# any `tokio_postgres::` path, so the generated `PgRange<T>` wrapper's
# `use postgres_protocol::types::{range_from_sql, range_to_sql}` cannot name it
# without this line. tokio-postgres ships no range type of its own -- unlike
# sqlx, which has `sqlx::postgres::types::PgRange` -- so the wrapper is
# hand-emitted against the wire-format primitives.
postgres-protocol = "0.6"
{%- endif %}
