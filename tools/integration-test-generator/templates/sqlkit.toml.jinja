[sqlkit]
version = "1"

[[sql]]
name = "main"
engine = "{{ engine }}"
schema = ["{{ schema_dir }}/{{ schema_file }}"]
queries = ["{{ queries_dir }}/*.sql"]

[[sql.gen]]
backend = "{{ backend }}"
{%- if backend == "rust-sqlx" %}
output = "src"
structs_only = "true"
{%- else %}
output = "src"
{%- endif %}
{%- if options.row_type %}
row_type = "{{ options.row_type }}"
{%- endif %}
{%- if options.outer_join_unions %}
outer_join_unions = "{{ options.outer_join_unions }}"
{%- endif %}
{%- if options.field_case %}
field_case = "{{ options.field_case }}"
{%- endif %}
